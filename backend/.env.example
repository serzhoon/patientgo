# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env НЕ коммитится в git (он в .gitignore).

# --- База данных MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ваш_пароль_от_mysql
DB_NAME=clinic

# --- Сервер ---
PORT=3000

# --- Какому фронтенду разрешено обращаться к API (CORS) ---
# Для разработки можно оставить *  (любой).
# Для продакшна укажите адрес GitHub Pages, например:
# CORS_ORIGIN=https://ваш-логин.github.io
CORS_ORIGIN=*

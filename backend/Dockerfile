# Dockerfile для бэкенда (Express).
# Собирает образ с нашим API.

# Берём официальный образ Node.js (лёгкая версия alpine).
FROM node:20-alpine

# Рабочая директория внутри контейнера.
WORKDIR /app

# Сначала копируем только package.json и ставим зависимости.
# Так Docker кеширует слой с зависимостями и пересобирает быстрее.
COPY package*.json ./
RUN npm install --omit=dev

# Теперь копируем остальной код.
COPY . .

# Контейнер будет слушать порт 3000.
EXPOSE 3000

# Команда запуска.
CMD ["npm", "start"]
